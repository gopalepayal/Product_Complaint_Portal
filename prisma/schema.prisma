generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  legalName            String
  email                String?               @unique
  phone                String?               @unique
  displayName          String?
  passwordHash         String?
  role                 UserRole              @default(CONSUMER)
  isVerified           Boolean               @default(false)
  verifiedAt           DateTime?
  emailVerified        Boolean               @default(false)
  emailVerifiedAt      DateTime?
  phoneVerified        Boolean               @default(false)
  phoneVerifiedAt      DateTime?
  isActive             Boolean               @default(true)
  anonymityDefault     Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  brandRepReviews      BrandRepresentative[] @relation("BrandRepReviewedBy")
  brandRepresentatives BrandRepresentative[] @relation("BrandRepUser")
  comments             Comment[]
  complaints           Complaint[]           @relation("ComplaintConsumer")
  notifications        Notification[]
  reportReviews        Report[]              @relation("ReportReviewedBy")
  reports              Report[]              @relation("ReportUser")
  statusChanges        StatusHistory[]       @relation("StatusChangedBy")
  verificationCodes    VerificationCode[]
  votes                Vote[]
}

model VerificationCode {
  id         String              @id @default(cuid())
  userId     String?
  email      String?
  phone      String?
  purpose    VerificationPurpose
  otpHash    String
  attempts   Int                 @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime            @default(now())
  user       User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([phone])
  @@index([userId])
  @@index([purpose])
}

model Brand {
  id                 String                @id @default(cuid())
  name               String                @unique
  slug               String                @unique
  logoUrl            String?
  category           String?
  officialWebsite    String?
  verificationStatus VerificationStatus    @default(PENDING)
  verifiedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  representatives    BrandRepresentative[]
  complaints         Complaint[]
  products           Product[]

  @@index([name])
  @@index([category])
}

model BrandRepresentative {
  id            String          @id @default(cuid())
  userId        String
  brandId       String
  companyName   String?
  workEmail     String
  jobTitle      String?
  proofDocument String?
  status        BrandRepStatus  @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  reviewedBy    User?           @relation("BrandRepReviewedBy", fields: [reviewedById], references: [id])
  brand         Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user          User            @relation("BrandRepUser", fields: [userId], references: [id], onDelete: Cascade)
  comments      Comment[]
  statusChanges StatusHistory[] @relation("BrandRepStatusChanges")

  @@unique([userId, brandId])
  @@index([brandId])
  @@index([status])
  @@index([workEmail])
}

model Product {
  id               String      @id @default(cuid())
  brandId          String
  name             String
  type             String
  category         String
  modelName        String?
  modelNumber      String?
  serialNumber     String?
  imageUrl         String?
  description      String?
  purchaseLocation String?
  mergedIntoId     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  complaints       Complaint[]
  mergedInto       Product?    @relation("ProductMerge", fields: [mergedIntoId], references: [id])
  mergedFrom       Product[]   @relation("ProductMerge")
  brand            Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([name])
  @@index([type])
  @@index([category])
  @@index([modelName])
  @@index([modelNumber])
}

model Complaint {
  id                String            @id @default(cuid())
  complaintNumber   String            @unique
  consumerId        String?
  contactEmail      String?
  contactPhone      String?
  productId         String
  brandId           String
  title             String
  description       String
  incidentDate      DateTime?
  purchaseDate      DateTime?
  retailer          String?
  purchaseCity      String?
  purchaseState     String?
  purchaseCountry   String?
  issueCategory     String
  severity          ComplaintSeverity @default(MEDIUM)
  desiredResolution String?
  isAnonymous             Boolean           @default(false)
  displayName             String?
  status                  ComplaintStatus   @default(UNDER_REVIEW)
  moderationNote    String?
  publishedAt       DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  attachments       Attachment[]
  comments          Comment[]
  brand             Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  consumer          User?             @relation("ComplaintConsumer", fields: [consumerId], references: [id], onDelete: Cascade)
  notifications     Notification[]
  reports           Report[]
  statusHistory     StatusHistory[]
  votes             Vote[]

  @@index([consumerId])
  @@index([productId])
  @@index([brandId])
  @@index([status])
  @@index([issueCategory])
  @@index([severity])
  @@index([createdAt])
}

model Attachment {
  id          String    @id @default(cuid())
  complaintId String
  fileName    String
  storageKey  String
  mimeType    String
  fileSize    Int
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model Comment {
  id                    String               @id @default(cuid())
  complaintId           String
  userId                String
  brandRepresentativeId String?
  content               String
  status                ModerationStatus     @default(PENDING)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  brandRepresentative   BrandRepresentative? @relation(fields: [brandRepresentativeId], references: [id])
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint             Complaint            @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  reports               Report[]

  @@index([complaintId])
  @@index([userId])
  @@index([brandRepresentativeId])
  @@index([status])
}

model Vote {
  id          String    @id @default(cuid())
  complaintId String
  userId      String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@unique([complaintId, userId])
  @@index([complaintId])
  @@index([userId])
}

model Report {
  id           String       @id @default(cuid())
  complaintId  String?
  commentId    String?
  userId       String
  reason       String
  description  String?
  status       ReportStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  reviewedBy   User?        @relation("ReportReviewedBy", fields: [reviewedById], references: [id])
  user         User         @relation("ReportUser", fields: [userId], references: [id], onDelete: Cascade)
  comment      Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  complaint    Complaint?   @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([commentId])
  @@index([userId])
  @@index([status])
}

model StatusHistory {
  id          String               @id @default(cuid())
  complaintId String
  status      ComplaintStatus
  note        String?
  changedById String?
  brandRepId  String?
  createdAt   DateTime             @default(now())
  brandRep    BrandRepresentative? @relation("BrandRepStatusChanges", fields: [brandRepId], references: [id])
  changedBy   User?                @relation("StatusChangedBy", fields: [changedById], references: [id])
  complaint   Complaint            @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([status])
  @@index([changedById])
  @@index([brandRepId])
}

model Notification {
  id          String     @id @default(cuid())
  userId      String
  complaintId String?
  title       String
  message     String
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([complaintId])
  @@index([isRead])
}

enum UserRole {
  CONSUMER
  BRAND_REP
  MODERATOR
  ADMIN
}

enum VerificationPurpose {
  REGISTRATION
  PASSWORD_RESET
  COMPLAINT_POSTING
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BrandRepStatus {
  PENDING
  VERIFIED
  REJECTED
  REVOKED
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  SUBMITTED
  PENDING_REVIEW
  UNDER_REVIEW
  PUBLISHED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
  DISPUTED
}

enum ModerationStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}
